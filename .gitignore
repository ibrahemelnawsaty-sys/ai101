# Secrets - art. 13, rule 10. Nothing resembling a credential is committed.
.env
.env.*
!.env.example
auth.json

# Dependencies and build output
/vendor
/node_modules
/public/hot
/public/storage

# public/build is COMMITTED on purpose - see D-38.
# There is no Node runtime on the shared host, so the compiled assets have to
# arrive some other way. Every manual transfer of them failed silently at least
# once during the first deploy: the page renders, the CSS is a release behind,
# and nothing anywhere reports an error. Committing them makes `git pull` the
# whole deployment. Reverse this line the day a build step runs on the host.

# Runtime state.
# The directories themselves are tracked through their own .gitignore files,
# so a fresh clone has a writable storage tree without any mkdir step.
/storage/*.key
/storage/pail

# Tooling caches
/.phpunit.cache
.phpunit.result.cache
/.phpstan.cache
/.pint.cache

# Release archives produced by deploy/
/deploy/build
*.tar.gz
*.zip

# Editors and operating systems
/.idea
/.vscode
/.fleet
/.nova
/.zed
.DS_Store
Thumbs.db
desktop.ini

# Python scratch that landed in this tree by accident: a 423 MB virtualenv and
# the training-day slide folder that contains nothing but another one.
.venv/
/15-شرائح/

# Local SQLite scratch file. The application runs on MySQL (art. 9); this file
# is a leftover and is never the source of truth.
/database/*.sqlite
/database/*.sqlite-journal

# Editor and tooling backups
*.bak

# Sample dataset from the Python training day - not part of this application.
/مبيعات_متجر_أثر.csv

# Probe artefacts written by tools/offline-checks. Never committed.
/public/create-probe.html
/public/create-probe.png
/public/build/select-probe.html
/public/*-probe.html
/public/roster-probe.json
/public/roster-probe.meta
/public/certificate-probe.html
