# =============================================================================
#  Athar platform - environment template
# =============================================================================
#  Copy to .env, then: php artisan key:generate
#
#  On the production host this file lives OUTSIDE the web root and is chmod 600
#  (Constitution art. 10, deploy/README.md §6). It is never committed.
#
#  Rules that apply to every value below:
#    - No secret is ever committed. Placeholders only.
#    - env() is read in config/ and nowhere else (art. 13, rule 14). Anything
#      you add here needs a matching key in a config file to be reachable.
#    - Arabic display text lives here rather than in PHP source, because
#      Arabic inside a .php file is forbidden (art. 13, rule 3).
# =============================================================================


# --- Application -------------------------------------------------------------

APP_NAME=Athar
APP_ENV=local
APP_KEY=
# false in production, WITHOUT EXCEPTION (art. 12). A true here is an incident.
APP_DEBUG=true
# The single source of every absolute link (BR-36). https, no trailing slash.
APP_URL=http://localhost

# Storage is UTC. config/app.php hardcodes it and deliberately ignores this
# variable, so a typo can never shift what is written to the database (art. 11).
APP_TIMEZONE=UTC

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file


# --- Athar identity (PROJECT-CONTRACT §1) ------------------------------------

ATHAR_PROGRAM_NAME="البرنامج التأسيسي في الذكاء الاصطناعي"
ATHAR_PROGRAM_SHORT_NAME="AI 101"
ATHAR_PLATFORM_NAME="منصة البرامج التدريبية — مركز أثر"
ATHAR_TAGLINE="من هنا يبدأ الأثر"

ATHAR_DOMAIN=ai.wareed.vip
ATHAR_CENTER_DOMAIN=athar-dev.edu.sa

# The address shown to visitors. The sending address is MAIL_FROM_ADDRESS below
# and the two are not the same.
ATHAR_EMAIL=contact@athar-dev.edu.sa

# Digits only, international format, no '+' and no separators - pasted straight
# into a wa.me link.
ATHAR_WHATSAPP=966582090332

# Display timezone. Storage stays UTC; conversion is Clock::riyadh().
ATHAR_DISPLAY_TIMEZONE=Asia/Riyadh

# Certificate serial prefix - produces ATHAR-AI101-2026-0001 (PRD §9.17).
ATHAR_CERTIFICATE_PREFIX=ATHAR-AI101


# --- Database ----------------------------------------------------------------
#  MySQL 8 / MariaDB 10.6+, InnoDB, utf8mb4_unicode_ci (art. 9).
#  The application database user needs SELECT/INSERT/UPDATE/DELETE and DDL for
#  migrations - but must NOT hold UPDATE or DELETE on `audit_logs` (art. 8).

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=athar
DB_USERNAME=root
DB_PASSWORD=

# Test database. The suite runs on MySQL, not SQLite: BR-06 and BR-12 are
# proven against the real unique key and CHECK constraint.
# Create it once:  CREATE DATABASE athar_testing
#                  CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;


# --- Sessions ----------------------------------------------------------------
#  Table is `user_sessions`, because `sessions` is a domain table here.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# true in every environment served over HTTPS. Setting it true before the
# certificate works means nobody can sign in.
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=


# --- Cache and queue ---------------------------------------------------------
#  Database for both. No Redis, no supervisor, no daemon (art. 10).
#  The queue is drained by cron:
#    * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1

CACHE_STORE=database
QUEUE_CONNECTION=database


# --- Filesystem --------------------------------------------------------------
#  Uploads go to a private disk outside the web root, reachable only through a
#  permission check and a 15-minute signed URL (PRD §12.5).

FILESYSTEM_DISK=private


# --- Hashing -----------------------------------------------------------------
#  bcrypt cost 12 in every real environment (art. 9). The test suite uses 4.

HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12


# --- Logging -----------------------------------------------------------------
#  Diagnostics only. The record of who did what is `audit_logs`, never a log
#  file. No personal data, no tokens, no passwords in a log line.

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null


# --- Mail --------------------------------------------------------------------
#  D-02 is DECIDED: outbound mail goes through the centre's own mailbox,
#  info@athar-dev.edu.sa. That domain's MX is smtp.google.com, so the mailbox is
#  Google Workspace and NOT Hostinger — smtp.hostinger.com would never have
#  authenticated. Verify with:  nslookup -type=mx athar-dev.edu.sa
#
#  MAIL_PASSWORD is almost certainly an APP PASSWORD, not the account password:
#  Google stopped accepting a plain account password for SMTP. Generate one at
#  myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
#  Sixteen characters, no spaces. If SMTP answers 535-5.7.8 BadCredentials, this
#  is why.
#
#  DELIVERABILITY, and it is not optional: athar-dev.edu.sa has NO SPF record
#  today. Mail claiming to come from it is unauthenticated and lands in spam.
#  Add, at the DNS host for that domain:
#      TXT  @  "v=spf1 include:_spf.google.com ~all"
#  and enable DKIM in the Workspace admin console. Until both exist, a reset
#  link that "was sent" still will not arrive.

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=info@athar-dev.edu.sa
MAIL_PASSWORD=
# The EHLO name. Some providers reject a handshake announcing "localhost".
MAIL_EHLO_DOMAIN=ai.wareed.vip

# Sends FROM the operations mailbox, replies go to the public contact address
# (C-03, D-15).
MAIL_FROM_ADDRESS=info@athar-dev.edu.sa
MAIL_FROM_NAME="منصة البرامج التدريبية — مركز أثر"
MAIL_REPLY_TO_ADDRESS=contact@athar-dev.edu.sa


# --- Build -------------------------------------------------------------------
#  Assets are compiled where Node exists and public/build is uploaded. There is
#  no Node runtime on the production host.

VITE_APP_NAME="${APP_NAME}"
